# AgentBoundary environment template — NAMES ONLY, never values.
# Copy to .env (gitignored) or export in the shell that starts the backend.
# AGENTBOUNDARY_LLM_API_KEY must never be committed, logged, or shared.

# Required for REMOTE real-LLM evaluation (server-side only). Leave unset
# for offline scripted mode, which is the default and needs nothing here.
AGENTBOUNDARY_LLM_API_KEY=

# FA-09: free LOCAL model alternative — no key needed. Set to 1 AND point
# BASE_URL at loopback Ollama (http://127.0.0.1:11434/v1) AND set MODEL to
# a pulled tag (e.g. qwen2.5:3b). The opt-in never applies to remote hosts.
# See scripts/local-llm-setup.sh and docs/real-llm-evaluation.md.
AGENTBOUNDARY_LLM_LOCAL_OLLAMA=

# Optional: any OpenAI-compatible chat-completions endpoint.
# Default: https://api.openai.com/v1
AGENTBOUNDARY_LLM_BASE_URL=

# Optional: model name. Default: gpt-4o-mini (a default, not a usage claim).
AGENTBOUNDARY_LLM_MODEL=

# Optional: sampling temperature. Default: 0.0
AGENTBOUNDARY_LLM_TEMPERATURE=

# Demo database path (optional; default backend/data/agentboundary.db).
AGENTBOUNDARY_DB_PATH=

# Weak-mode CLI opt-in (optional; default unset = refused).
# AGENTBOUNDARY_UNSAFE_LAB=1 is required for `run-weak` and nothing else.
AGENTBOUNDARY_UNSAFE_LAB=
