# Copy to .env for local overrides. Never commit a real .env. No secrets are required for the offline lab.
AGENTBOUNDARY_DB_PATH=
AGENTBOUNDARY_HOST=127.0.0.1
AGENTBOUNDARY_PORT=8000
# Optional real-model adapter (NOT configured by default; offline system does not need it):
# AGENTBOUNDARY_LLM_PROVIDER=
# AGENTBOUNDARY_LLM_MODEL=
# Provider API keys belong in your local secret manager / environment, never in this repo.
# Deliberately NOT an env example: AGENTBOUNDARY_UNSAFE_LAB — weak mode is an offline CLI
# opt-in documented in SECURITY.md; do not set it in any shared or deployed environment.
